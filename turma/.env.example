# turma connectors + tooling env.
# Copy to a .env in the HOST project (gitignored there). Fill only what you use.
# turma stays generic; these creds belong to the project you're growing.

# beehiiv-connector (read a beehiiv publication: subs, posts, stats, segments)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# youtube-connector (read a YouTube channel + competitor research, public data)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# search-console-connector (read Google Search Console for SEO analysis)
SEARCH_CONSOLE_KEY=        # absolute path to the service-account JSON key
SEARCH_CONSOLE_SITE_URL=   # e.g. https://yoursite.com/  or  sc-domain:yoursite.com

# cta-machine (YouTube Shorts engine: scheduling + uploads)
# see turma/skills/cta-machine/.env.example for the full tooling set (Postiz, etc.)
POSTIZ_API_KEY=
POSTIZ_API_URL=
