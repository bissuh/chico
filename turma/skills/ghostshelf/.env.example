# Copy to .env in your project root and fill in. .env is gitignored. Never commit it.

# Postiz public API key. Postiz Settings -> Developers -> Public API -> generate.
POSTIZ_API_KEY=

# Your Postiz integration IDs. List them with:
#   curl -s -H "Authorization: $POSTIZ_API_KEY" https://api.postiz.com/public/v1/integrations
# Only the platforms your batch actually posts to are required.
POSTIZ_INSTAGRAM_INTEGRATION_ID=
POSTIZ_TIKTOK_INTEGRATION_ID=
POSTIZ_YOUTUBE_INTEGRATION_ID=
