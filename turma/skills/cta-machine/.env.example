# Copy to .env and fill in. .env is gitignored. Never commit it.

# YouTube Data API v3 key (free, 10,000 units/day).
# console.cloud.google.com -> enable "YouTube Data API v3" -> create API key
YOUTUBE_API_KEY=

# Postiz public API key.
# Postiz Settings -> Developers -> Public API -> generate
POSTIZ_API_KEY=

# Your Postiz YouTube integration ID. Find it with:
#   curl -s -H "Authorization: $POSTIZ_API_KEY" https://api.postiz.com/public/v1/integrations
POSTIZ_YOUTUBE_INTEGRATION_ID=

# The post metadata that is IDENTICAL on every video (that sameness is your brand signal).
CTA_POST_TITLE=Your one-line hook | yourdomain.com
CTA_POST_DESCRIPTION=Get the free thing: yourdomain.com

One sentence about who it is for and why.
CTA_POST_TAGS=Shorts,Entrepreneur,Startup,Side Hustle

# Optional: where assets/ledger live. Defaults to the current working directory.
# CTA_WORKDIR=/absolute/path/to/your/project
