memory/
inbox/
outbox/*
!outbox/README.md
sessions/
.venv/
.DS_Store
.env
.env.*
!.env.example
.claude/settings.local.json

# private: tactics, research, local-path notes, channel automation code
# (folders stay on GitHub as signposts with a README; the working files do not)
playbooks/*
!playbooks/README.md
knowledge-base/*
!knowledge-base/README.md

# standards/ is public craft. only the source registry stays local, because it
# holds absolute paths and the names of the repos that own each file.
standards/.sources

# private per-project business data: filled brand.md, raw learnings, client notes.
# turma (the craft) is public; a project's audience/offer/numbers are not.
clients/*
!clients/README.md
# defensive: a filled config or raw learnings log anywhere in the tree stays local
**/brand.local.md
**/learnings.local.md
**/growth/brand.md
**/growth/learnings.md
**/growth/references.md

# build artifacts from the skills that ship tooling (renderers, schedulers)
node_modules/
**/remotion/out/
**/remotion/.cache/
**/out/schedule-ledger.json

# python bytecode
__pycache__/
*.pyc
