# Copy to .env and fill in real values. .env is gitignored, never commit it.
#
# Chico reads credentials from the project he is working. This file is the
# superset every turma connector might ask for; a given project usually needs
# two or three lines, not all of them. Each connector's SKILL.md says which.

# --- turma:beehiiv-connector ---
# beehiiv dashboard -> Settings -> Integrations -> API
BEEHIIV_API_KEY=
# curl -H "Authorization: Bearer $BEEHIIV_API_KEY" https://api.beehiiv.com/v2/publications
BEEHIIV_PUBLICATION_ID=

# --- turma:youtube-connector ---
# console.cloud.google.com -> new project -> enable "YouTube Data API v3" -> API key
YOUTUBE_API_KEY=
# YouTube Studio -> Settings -> Channel -> Advanced, or search the API by channel name
YOUTUBE_CHANNEL_ID=

# --- turma:cta-machine and turma:ghostshelf (scheduling) ---
# postiz.com -> Settings -> Developers -> Public API
POSTIZ_API_KEY=
# List every connected account and its id:
#   curl -s -H "Authorization: $POSTIZ_API_KEY" https://api.postiz.com/public/v1/integrations
POSTIZ_INSTAGRAM_INTEGRATION_ID=
POSTIZ_TIKTOK_INTEGRATION_ID=
POSTIZ_YOUTUBE_INTEGRATION_ID=

# --- turma:search-console-connector ---
# Absolute path to a service-account JSON key with read access on the property.
# Keep the JSON file itself out of git; it is a credential.
SEARCH_CONSOLE_KEY=
# The property: https://yoursite.com/ , or sc-domain:yoursite.com for a domain property.
SEARCH_CONSOLE_SITE_URL=
